[importlinter]
root_packages =
    shared
    contexts
    orchestrator
    api

[importlinter:contract:shared-layers]
name = shared.common -> shared.infrastructure (one-way)
type = layers
layers =
    shared.common
    shared.infrastructure

[importlinter:contract:shared-isolated]
name = shared must not depend on contexts/orchestrator/api
type = forbidden
source_modules =
    shared
forbidden_modules =
    contexts
    orchestrator
    api

[importlinter:contract:contexts-leaf-independent]
name = Leaf contexts and self_practice stay independent
type = independence
modules =
    contexts.sales_assistant
    contexts.teaching_assistant
    contexts.course_assistant
    contexts.learning_analytics
    contexts.self_practice

[importlinter:contract:practice-producers-one-way]
name = Practice producers may only depend on self_practice ports
type = forbidden
source_modules =
    contexts.exam_paper_generation
    contexts.exam_grading
forbidden_modules =
    contexts.exam_paper_generation
    contexts.exam_grading
    contexts.sales_assistant
    contexts.teaching_assistant
    contexts.course_assistant
    contexts.learning_analytics
